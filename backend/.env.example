PROJECT_NAME="AURA"
API_V1_STR="/api/v1"
DATABASE_URL=test

SUPABASE_URL=https://test.supabase.co

SUPABASE_KEY=testkey

# Optional: enables AI-phrased recommendations (hybrid: rules.json still
# decides which categories are eligible; the LLM only rephrases/personalizes).
# Leave USE_AI_RECOMMENDATION_ENGINE=false (or GROQ_API_KEY unset) to
# use plain rule-based recommendation text with zero external API calls.
USE_AI_RECOMMENDATION_ENGINE=false
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
